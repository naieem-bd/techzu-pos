# Copy to .env and fill in real values. Never commit .env.

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated. If unset and RENDER_EXTERNAL_URL is set (Render does this), that URL is used.
CORS_ORIGIN=http://localhost:5173
# Production entrypoint (dist/start.js) runs the idempotent demo seed after migrations when true
SEED_ON_START=false
# Host port for the `app` service in docker-compose.yml (keep different from PORT if you
# run `npm run dev` at the same time)
APP_PORT=3000

# Postgres (used by docker-compose.yml)
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=techzu_pos
POSTGRES_TEST_DB=techzu_pos_test
DB_PORT=5432
TEST_DB_PORT=5433

# Connection strings used by the server
# Local (docker compose): plain connection to the compose Postgres, DB_SSL=false.
# Hosted (Neon): set DB_SSL=true and paste Neon's DIRECT (non-pooled) connection string, i.e.
#   the host WITHOUT "-pooler", e.g.
#   postgresql://<user>:<password>@ep-<name>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
#   Migrations and sale transactions rely on one server session per transaction, so don't put
#   PgBouncer (Neon's pooled endpoint) in front of them; the app's own pg pool does the pooling.
#   The server strips sslmode/channel_binding from the URL and applies its own settings:
#   certificate + hostname verification, and channel binding unless channel_binding=disable.
DATABASE_URL=postgres://pos_user:change_me@localhost:5432/techzu_pos
# Tests override DATABASE_URL with this value (see server/tests/setup-env.ts)
TEST_DATABASE_URL=postgres://pos_user:change_me@localhost:5433/techzu_pos_test
# TLS to Postgres: false locally, true for Neon. Startup fails if DATABASE_URL contradicts it
# (e.g. sslmode=require with DB_SSL=false).
DB_SSL=false
# Max connections in the server's pg pool (keep below the database's max_connections)
DB_POOL_MAX=10
